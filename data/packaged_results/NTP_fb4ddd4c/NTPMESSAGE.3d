typedef struct _Zero {
  UINT8BE Zero { Zero == 0 };
} Zero;

typedef struct _KissCode {
  UINT8BE c1 { c1 >= 0x20 && c1 <= 0x7E };
  UINT8BE c2 { c2 >= 0x20 && c2 <= 0x7E };
  UINT8BE c3 { c3 >= 0x20 && c3 <= 0x7E };
  UINT8BE c4 { (c4 == 0 || (c4 >= 0x20 && c4 <= 0x7E)) && (c1 != 0 || c2 != 0 || c3 != 0 || c4 != 0) };
} KissCode;

typedef struct _AsciiRefId {
  UINT8BE b1 { b1 >= 0x20 && b1 <= 0x7E };
  UINT8BE b2 { b2 >= 0x20 && b2 <= 0x7E };
  UINT8BE b3 { b3 >= 0x20 && b3 <= 0x7E };
  UINT8BE b4 { b4 == 0 && (b1 != 0 || b2 != 0 || b3 != 0) };
} AsciiRefId;

casetype _ReferenceId(UINT8BE Stratum) {
  switch (Stratum) {
    case 0: KissCode kissCode;
    case 1: AsciiRefId refId;
    case 2: struct {
        UINT8BE IPv4Address[4];
    } ipAddress2;
    case 3: struct {
        UINT8BE IPv4Address[4];
    } ipAddress3;
    case 4: struct {
        UINT8BE IPv4Address[4];
    } ipAddress4;
    case 5: struct {
        UINT8BE IPv4Address[4];
    } ipAddress5;
    case 6: struct {
        UINT8BE IPv4Address[4];
    } ipAddress6;
    case 7: struct {
        UINT8BE IPv4Address[4];
    } ipAddress7;
    case 8: struct {
        UINT8BE IPv4Address[4];
    } ipAddress8;
    case 9: struct {
        UINT8BE IPv4Address[4];
    } ipAddress9;
    case 10: struct {
        UINT8BE IPv4Address[4];
    } ipAddress10;
    case 11: struct {
        UINT8BE IPv4Address[4];
    } ipAddress11;
    case 12: struct {
        UINT8BE IPv4Address[4];
    } ipAddress12;
    case 13: struct {
        UINT8BE IPv4Address[4];
    } ipAddress13;
    case 14: struct {
        UINT8BE IPv4Address[4];
    } ipAddress14;
    case 15: struct {
        UINT8BE IPv4Address[4];
    } ipAddress15;
    case 16: struct {
        UINT8BE IPv4Address[4];
    } ipAddress16;
  }
} ReferenceId;

typedef struct _ExtensionField {
  UINT16BE FieldType;
  UINT16BE Length { Length >= 16 && Length % 4 == 0 };
  UINT8BE Value[:byte-size (Length - 4)];
} ExtensionField;

typedef struct _MACField {
  UINT32BE KeyIdentifier;
  UINT8BE Digest[16];
} MACField;

typedef struct _NTPHeader {
    UINT8BE LI: 2;
    UINT8BE VN: 3 { VN >= 1 && VN <= 7 };
    UINT8BE Mode: 3 { Mode >= 1 && Mode <= 7 };
    UINT8BE Stratum { Stratum >= 0 && Stratum <= 16 };
    UINT8BE Poll;
    UINT8BE Precision;
    UINT32BE RootDelay;
    UINT32BE RootDispersion;
    ReferenceId(Stratum) RefId;
    UINT64BE ReferenceTimestamp;
    UINT64BE OriginateTimestamp;
    UINT64BE ReceiveTimestamp;
    UINT64BE TransmitTimestamp;
} NTPHeader;

casetype _NTPBody(UINT32BE TotalLength) {
  switch (TotalLength) {
    case 48: struct {
      unit Empty;
    } NoExtNoMac;
    case 68: struct {
      MACField MAC;
    } MacOnly;
    case 69: struct {
      ExtensionField Extensions[:byte-size 1];
      MACField MAC;
    } Ext1Mac;
    case 70: struct {
      ExtensionField Extensions[:byte-size 2];
      MACField MAC;
    } Ext2Mac;
    case 71: struct {
      ExtensionField Extensions[:byte-size 3];
      MACField MAC;
    } Ext3Mac;
    // ... For brevity, in real code, enumerate all possible valid sizes or use a parameterized struct
  }
} NTPBody;

entrypoint typedef struct _NTPMessage(UINT32BE TotalLength) where (
  TotalLength >= 48 && (TotalLength == 48 || TotalLength == 68 || TotalLength == 69 || TotalLength == 70 || TotalLength == 71)
) {
    NTPHeader header;
    NTPBody(TotalLength) body;
} NTPMessage;
